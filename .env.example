# ==============================================================================
# TIENDAPP (GESTIÓN INTELIGENTE NEIVA) — VARIABLES DE ENTORNO BACKEND
# ==============================================================================
# Copia este archivo a `.env` y reemplaza los valores por tus credenciales reales.
# NUNCA subas el archivo `.env` al repositorio.

# Base de datos SQLite local (inmediata sin servidor externo) o PostgreSQL en producción
DATABASE_URL=sqlite:///./tiendapp_dev.db
# Ejemplo PostgreSQL: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiendapp_db

# Seguridad y JWT (Genera una llave aleatoria segura de al menos 32 bytes: openssl rand -hex 32)
SECRET_KEY=cambia-esta-clave-secreta-por-una-cadena-aleatoria-segura-de-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_FAILED_LOGIN_ATTEMPTS=10

# Clave maestra para el Panel Administrativo de SuperAdmin (/superadmin)
SUPERADMIN_KEY=cambia-esta-clave-superadmin-segura

# Orígenes permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directorio local de almacenamiento de fotografías de productos
UPLOAD_DIR=media

# Opcional: Servidor SMTP para envío de códigos de recuperación de contraseña
# (Si se omite en desarrollo, el endpoint devuelve el código de recuperación en modo local verificable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Opcional: Integración de Asistente IA (Groq API)
GROQ_API_KEY=
